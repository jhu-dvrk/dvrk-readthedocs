// Regenerate from this directory: python3 ../usage/render-dot.py video-and-data.dot
digraph video_and_data {
  graph [rankdir=TB, splines=ortho, newrank=true, compound=true, bgcolor="white", pad=0.25,
         nodesep=1.0, ranksep=1.1, fontname="Arial,Helvetica,sans-serif"];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#64748b",
        fontname="Arial,Helvetica,sans-serif", fontsize=12, margin="0.16,0.12"];
  edge [color="#475569", fontcolor="#475569", fontname="Arial,Helvetica,sans-serif",
        fontsize=10, arrowsize=0.7];

  subgraph column_control {
    label=""; style=invis;
    subgraph cluster_system {
      label="dvrk_robot::dvrk_system"; color="#94a3b8"; style=rounded;
      console [label="dVRK console\nRobot state and operator inputs", group="control"];
    }
  }
  subgraph column_video {
    label=""; style=invis;
    cameras [label="Left + right cameras", fillcolor="#fff7ed", group="video"];
    source [label="dvrk_data::stereo_source\nCapture, timestamps, latest images",
            fillcolor="#f0fdfa", group="video"];
    alignment [label="dvrk_data::stereo_alignment\nColor, crop, shifts, scale",
               fillcolor="#f0fdfa", group="video"];
    display [label="dvrk_console::stereo_display\nHUD, AR, PiP, frame timing",
             fillcolor="#f0fdfa", group="video"];
    viewer [label="Physical surgeon display\nHRSV or monitor",
            fillcolor="#fff7ed", group="video"];
    record [label="dvrk_data::record\nMP4 + timestamp sidecars\nOptional audio and MCAP",
            fillcolor="#f0fdfa", group="record"];
  }
  subgraph column_panel {
    label=""; style=invis;
    control_panel [label="dvrk_console::control_panel\nOperator controls and status\nOptional video previews",
                   group="panel"];
    touchscreen [label="Touch screen", fillcolor="#fff7ed", group="panel"];
  }

  cameras -> source [color="#dc2626", fontcolor="#dc2626",
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>Camera input</TD></TR></TABLE>>];
  source -> alignment [color="#15803d", fontcolor="#15803d",
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>Stereo</TD></TR></TABLE>>];
  alignment -> display [color="#15803d", fontcolor="#15803d",
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>Aligned stereo</TD></TR></TABLE>>];
  alignment -> record [color="#15803d", fontcolor="#15803d",
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>Aligned stereo</TD></TR></TABLE>>];
  display -> viewer [color="#dc2626", fontcolor="#dc2626",
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>DP, HDMI</TD></TR></TABLE>>];
  console -> display [style=dashed, constraint=false,
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>ROS 2<BR/>console status</TD></TR></TABLE>>];
  console:e -> record:s [ltail=cluster_system, style=dashed, constraint=false,
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>ROS 2 topics</TD></TR></TABLE>>];
  console -> control_panel [dir=both, style=dashed, constraint=false,
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>ROS 2<BR/>commands, status</TD></TR></TABLE>>];
  source -> control_panel [color="#15803d", fontcolor="#15803d", constraint=false,
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>Stereo</TD></TR></TABLE>>];
  alignment -> control_panel [color="#15803d", fontcolor="#15803d", constraint=false,
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>Aligned stereo</TD></TR></TABLE>>];
  display -> control_panel [color="#15803d", fontcolor="#15803d", constraint=false,
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>Stereo overlay</TD></TR></TABLE>>];
  control_panel -> touchscreen [color="#dc2626", fontcolor="#dc2626",
    xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD>DP, HDMI</TD></TR></TABLE>>];

  {rank=same; display; record;}
  display -> record [style=invis];
  {rank=same; console; viewer; touchscreen;}
  column_order [shape=point, width=0, height=0, label="", style=invis, ordering=out];
  column_order -> console [style=invis];
  column_order -> viewer [style=invis];
  column_order -> touchscreen [style=invis];

  subgraph legend_rank {
    rank=sink;
    legend [shape=plain, style="", margin=0, label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
        <TR><TD COLSPAN="5" ALIGN="LEFT"><B>Connection legend</B></TD></TR>
        <TR><TD><FONT COLOR="#dc2626">━▶</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Physical connection</FONT></TD><TD WIDTH="20"></TD><TD><FONT COLOR="#15803d">━▶</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">GStreamer socket (video)</FONT></TD></TR>
        <TR><TD><FONT COLOR="#475569">┄▶</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ROS 2 communication</FONT></TD><TD WIDTH="20"></TD><TD COLSPAN="2"></TD></TR>
      </TABLE>
    >];
  }
  console -> legend [style=invis];
  viewer -> legend [style=invis];
  touchscreen -> legend [style=invis];
}
